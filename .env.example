CUPSADMIN=print
CUPSPASSWORD=print
TZ=Asia/Shanghai

# ── 支付宝（可选）─────────────────────────────────────────────────────
# 四项齐全时支付宝才会出现在支付方式里。
#
# ⚠️ 这是【模板文件】，会被提交进版本库 —— 只写占位符，绝不要填真密钥。
#    真密钥写进 .env（已 gitignore）或 docker-compose 的 environment。
#
# 配置步骤：
#   1. 生成 RSA2 密钥对，把【应用公钥】上传到开放平台
#   2. 从开放平台复制【支付宝公钥】（⚠️ 不是应用公钥，两者很像）
#   3. 把下面四项填进 .env 或 docker-compose
#
# 沙箱联调把 ALIPAY_GATEWAY 指到
#   https://openapi-sandbox.dl.alipaydev.com/gateway.do
# 生产环境删掉这一行（代码默认就用正式网关）。
#
# 换商户 / 沙箱转生产：只改这四项 + 重启，不用改代码。
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=
# ALIPAY_GATEWAY=
