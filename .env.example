CUPSADMIN=print
CUPSPASSWORD=print
TZ=Asia/Shanghai

# ── 数据库（必填）───────────────────────────────────────────────────────
# 所有店连同一台中心 PostgreSQL。⚠️ 没有它程序起不来（已不再支持 SQLite）。
#
# 格式：postgres://用户名:密码@主机:端口/库名?sslmode=...
#
# ⚠️ 各店走公网连中心库时，sslmode 必须是 require 或更高，
#    否则连接串里的密码和全部订单数据都是明文过网。
#    同机 / 内网可信网段才用 disable。
#
# ⚠️ 建库时务必指定 C collation（见 internal/store/schema.sql 顶部说明）：
#    createdb  ... 或
#    CREATE DATABASE cupsweb LC_COLLATE 'C' LC_CTYPE 'C' TEMPLATE template0;
#    不指定的话，若集群默认是 ICU 非确定性 collation，
#    username 的唯一约束会把 Admin 与 admin 判为冲突，而且能用 ADMIN 登录。
#
# 建表不用手动做：程序启动时会执行 internal/store/schema.sql（幂等）。
#
# DATABASE_URL=postgres://cupsweb:密码@127.0.0.1:5432/cupsweb?sslmode=disable
#
# 每个实例向中心库开多少条连接（默认 10）。
# ⚠️ 所有店加起来不能超过服务端的 max_connections（PostgreSQL 默认 100）。
#    20 家店 × 10 = 200 会直接连不上，要么调大服务端、要么把这里调小。
# DB_MAX_CONNS=10

# ── 支付宝（可选）─────────────────────────────────────────────────────
# 四项齐全时支付宝才会出现在支付方式里。
#
# ⚠️ 这是【模板文件】，会被提交进版本库 —— 只写占位符，绝不要填真密钥。
#    真密钥写进 .env（已 gitignore）或 docker-compose 的 environment。
#
# 配置步骤：
#   1. 生成 RSA2 密钥对，把【应用公钥】上传到开放平台
#   2. 从开放平台复制【支付宝公钥】（⚠️ 不是应用公钥，两者很像）
#   3. 把下面四项填进 .env 或 docker-compose
#
# 沙箱联调把 ALIPAY_GATEWAY 指到
#   https://openapi-sandbox.dl.alipaydev.com/gateway.do
# 生产环境删掉这一行（代码默认就用正式网关）。
#
# 换商户 / 沙箱转生产：只改这四项 + 重启，不用改代码。
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=
# ALIPAY_GATEWAY=
#
# ── 支付宝授权登录（可选）─────────────────────────────────────────────
# 上面四项齐全即可用「支付宝登录」，无需额外配置 —— 用的是同一个应用的凭据。
# 授权页主机【与网关不是同一台】（openauth.alipay.com vs openapi.alipay.com），
# 代码按 ALIPAY_GATEWAY 是否沙箱自动推断。只有非常规部署才需要显式指定：
# ALIPAY_AUTH_URL=
#
# ⚠️ 上线前必须在开放平台后台配置「授权回调地址」，且要与本站实际地址一致
#    （形如 http://<host>:<port>/#/print）。改站点地址后这里也要跟着改。
# ⚠️ 还需要应用开通「获取会员信息」产品，并启用「应用-开发配置-openid 配置管理」。
